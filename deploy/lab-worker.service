[Unit]
Description=Indodax Research Lab Heavy Computation Worker
After=network.target

[Service]
Type=simple
User=indodax_lab
WorkingDirectory=/var/data/indodax_lab
EnvironmentFile=/etc/indodax_lab/lab.env
ExecStart=/opt/conda/envs/indodax_lab/bin/python -m indodax_lab.orchestration.worker
Restart=on-failure
RestartSec=30s
KillSignal=SIGTERM
TimeoutStopSec=60s

[Install]
WantedBy=multi-user.target
