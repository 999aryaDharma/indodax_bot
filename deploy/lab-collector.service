[Unit]
Description=Indodax Research Lab Market Data Collector
After=network.target

[Service]
Type=simple
User=indodax_lab
WorkingDirectory=/var/data/indodax_lab
EnvironmentFile=/etc/indodax_lab/lab.env
ExecStart=/opt/conda/envs/indodax_lab/bin/python -m indodax_lab.cli.collector
Restart=on-failure
RestartSec=10s
KillSignal=SIGTERM
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
